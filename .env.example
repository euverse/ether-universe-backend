# ==============================================================================
# Ether Universe Backend — environment variables
# Copy this file to .env and fill in the values.
# All variables are read via useRuntimeConfig() in nitro.config.ts, which loads
# .env from the project root. In production set them in the server environment
# or in .env on the VPS (/var/www/ether-universe/backend).
# ==============================================================================

# --- Server / public URLs -----------------------------------------------------
# BASE_URL is this API's own URL; WWW_BASE_URL is the frontend (used in
# password-reset links).
NITRO_BASE_URL=http://localhost:3000
NITRO_WWW_BASE_URL=http://localhost:3001

# --- Database (required — the server exits on startup without a connection) ---
# Currency conversion uses MongoDB transactions, which need a REPLICA SET
# (Atlas, or a self-hosted set such as ?replicaSet=rs0). On a standalone mongod
# /api/convert fails with "Transaction numbers are only allowed on a replica set
# member or mongos".
#   Local single-node replica set: mongodb://localhost:27017/ether-universe?replicaSet=rs0
#   Atlas:                         mongodb+srv://<user>:<password>@<cluster>/ether-universe
NITRO_MONGODB_URI=mongodb://localhost:27017/ether-universe?replicaSet=rs0

# --- Wallets --------------------------------------------------------------
# BIP39 mnemonic used to derive all custodial BTC/EVM wallets. This is a
# sensitive secret that controls real fund custody paths — generate your own,
# never reuse an example value, and never commit it. Changing it later makes
# existing deposit addresses unreachable.
NITRO_MASTER_MNEMONIC=

# --- Market data ---------------------------------------------------------
# Live prices (server/tasks/updateCryptoPrices.js, every 5 seconds). Must return
# the Binance 24hr ticker format (symbol, lastPrice, priceChangePercent, ...).
# Required: with it empty, live price updates fail.
NITRO_BINANCE_TICKER_URL=https://api.binance.com/api/v3/ticker/24hr
# Optional: CoinGecko demo API keys for historical price data
# (server/tasks/updatePriceData.js). The second key is a failover for the first.
# Leave blank to use CoinGecko's public rate limits.
NITRO_COIN_GECKO_API_KEY1=
NITRO_COIN_GECKO_API_KEY2=
# AbstractAPI key for IP geolocation lookups (server/api/ip.get.js).
NITRO_ABSTRACT_API_KEY=

# --- Auth secrets (JWT signing) -------------------------------------------
# Use long random values, all different from each other, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
NITRO_AUTH_USER_REFRESH_TOKEN_SECRET=
NITRO_AUTH_USER_ACCESS_TOKEN_SECRET=
NITRO_AUTH_ADMIN_REFRESH_TOKEN_SECRET=
NITRO_AUTH_ADMIN_ACCESS_TOKEN_SECRET=
NITRO_AUTH_PASSWORD_RESET_SECRET=

# --- Seed super-admin account ----------------------------------------------
# Created automatically on first successful DB connection (server/db/setup/admin.js)
# if no super admin exists yet.
NITRO_AUTH_CREDENTIALS_ADMIN_FULL_NAME=
NITRO_AUTH_CREDENTIALS_ADMIN_EMAIL=
NITRO_AUTH_CREDENTIALS_ADMIN_PASSWORD=

# --- Mail ------------------------------------------------------------------
# The SMTP host (smtp.zoho.com:465) and sender mailboxes
# (<name>@ether-universe.org) are hardcoded in server/services/mails/index.js;
# only the shared mailbox password is configurable.
NITRO_AUTH_MAIL_PASSWORD=

# --- Blockchain endpoints ---------------------------------------------------
# Used by the BTC/EVM deposit scanners and sweepers. Public endpoints are
# rate-limited; use a provider key for production.
# BTC must be an Esplora-style REST API (the code calls <url>/address/<addr>/utxo,
# <url>/blocks/tip/height, <url>/fee-estimates, <url>/tx), NOT a JSON-RPC node.
NITRO_RPC_URLS_BTC=https://blockstream.info/api
# Ethereum and Polygon are standard JSON-RPC endpoints.
NITRO_RPC_URLS_ETHEREUM=https://eth.llamarpc.com
NITRO_RPC_URLS_POLYGON=https://polygon.llamarpc.com
